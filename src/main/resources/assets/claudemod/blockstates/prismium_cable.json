{
    "multipart": [
        { "apply": { "model": "claudemod:block/prismium_cable" } },
        { "when": { "north": "true" }, "apply": { "model": "claudemod:block/prismium_cable_arm" } },
        { "when": { "south": "true" }, "apply": { "model": "claudemod:block/prismium_cable_arm", "y": 180 } },
        { "when": { "east":  "true" }, "apply": { "model": "claudemod:block/prismium_cable_arm", "y": 90 } },
        { "when": { "west":  "true" }, "apply": { "model": "claudemod:block/prismium_cable_arm", "y": 270 } },
        { "when": { "up":    "true" }, "apply": { "model": "claudemod:block/prismium_cable_arm", "x": 270 } },
        { "when": { "down":  "true" }, "apply": { "model": "claudemod:block/prismium_cable_arm", "x": 90 } }
    ]
}
